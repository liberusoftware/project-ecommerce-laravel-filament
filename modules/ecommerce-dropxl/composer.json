{
    "name": "liberusoftware/ecommerce-dropxl",
    "description": "DropXL dropshipping fulfilment and catalogue import for the Liberu ecommerce platform.",
    "type": "liberu-module",
    "version": "0.1.0",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "filament/filament": "^5.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "liberusoftware/ecommerce-contracts": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Ecommerce\\Dropxl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Ecommerce\\Dropxl\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "ecommerce-dropxl"
        }
    }
}
